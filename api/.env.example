# ── Flickr API credentials ──────────────────────────────────────────────────
# Get these from https://www.flickr.com/services/apps
FLICKR_API_KEY=your_api_key_here
FLICKR_API_SECRET=your_api_secret_here

# ── OAuth access token ───────────────────────────────────────────────────────
# Generate these by running: node get_flickr_token.js
FLICKR_OAUTH_TOKEN=your_oauth_token_here
FLICKR_OAUTH_TOKEN_SECRET=your_oauth_token_secret_here

# ── Flickr user ──────────────────────────────────────────────────────────────
# Your Flickr user ID (e.g. 12345678@N00) — also output by get_flickr_token.js
FLICKR_USER_ID=your_user_id_here

# ── Server ───────────────────────────────────────────────────────────────────
# Allowed CORS origin — your frontend URL
CORS_ORIGIN=https://your-domain.com

# Port to listen on (optional, defaults to 3001)
# PORT=3001
